<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/27"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.gem.controller.RemoverMedicamentoController"
    stylesheets="@movimentacao.css"
    minHeight="700.0"
    minWidth="1100.0"
    prefHeight="900.0"
    prefWidth="1440.0">

    <!-- ======================================================================
         SIDEBAR (Menu Lateral do Coordenador)
         ====================================================================== -->
    <left>
        <VBox prefWidth="260.0" styleClass="sidebar">
            <!-- Logo Header -->
            <VBox styleClass="sidebar-logo-container" spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <ImageView fitHeight="48.0" fitWidth="170.0" preserveRatio="true">
                        <image>
                            <Image url="@images/gem-icon-home.png"/>
                        </image>
                    </ImageView>
                </HBox>
                <Separator styleClass="sidebar-separator"/>
            </VBox>

            <!-- Navigation Links -->
            <VBox spacing="8" styleClass="sidebar-nav-container">
                <Button
                    maxWidth="Infinity"
                    prefHeight="44.0"
                    text="⇄  Movimentação"
                    onAction="#abrirMovimentacao"
                    styleClass="sidebar-nav-btn"/>

                <Button
                    maxWidth="Infinity"
                    prefHeight="44.0"
                    text="📦  Estoque"
                    onAction="#voltar"
                    styleClass="sidebar-nav-btn, sidebar-nav-btn-active"/>

                <Button
                    maxWidth="Infinity"
                    prefHeight="44.0"
                    text="🕒  Histórico"
                    onAction="#abrirHistorico"
                    styleClass="sidebar-nav-btn"/>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- User Footer Widget -->
            <VBox spacing="14" styleClass="sidebar-footer">
                <Separator styleClass="sidebar-separator"/>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label
                        prefHeight="42.0"
                        prefWidth="42.0"
                        minHeight="42.0"
                        minWidth="42.0"
                        text="GEM"
                        styleClass="sidebar-avatar"/>

                    <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS">
                        <Label
                            fx:id="usuarioLabel"
                            text="Coordenador"
                            styleClass="sidebar-user-name"/>
                        <Label
                            text="Coordenação Geral"
                            styleClass="sidebar-user-role"/>
                    </VBox>

                    <Button
                        text="➔"
                        onAction="#sair"
                        styleClass="sidebar-logout-btn"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- ======================================================================
         ÁREA PRINCIPAL
         ====================================================================== -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30 36 28 36;">

            <!-- Header Principal -->
            <HBox alignment="CENTER_LEFT" styleClass="main-header">
                <HBox alignment="CENTER_LEFT" spacing="14" HBox.hgrow="ALWAYS">
                    <Button text="← Voltar" onAction="#voltar" styleClass="nav-back-btn" focusTraversable="false"/>
                    <VBox spacing="4">
                        <Label text="Remover Medicamento" styleClass="header-title"/>
                        <Label text="Confirmação segura de descarte ou desativação de itens do inventário ativo." styleClass="header-subtitle"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Label fx:id="acessoLabel" text="Acesso: Coordenador" styleClass="header-profile-badge"/>
                    <Label prefHeight="38.0" prefWidth="38.0" text="COORD" styleClass="header-avatar"/>

                    <HBox alignment="CENTER_RIGHT" spacing="6" styleClass="window-controls">
                        <Button text="—" onAction="#minimizarJanela" styleClass="window-btn" focusTraversable="false"/>
                        <Button text="□" onAction="#maximizarJanela" styleClass="window-btn" focusTraversable="false"/>
                        <Button text="✕" onAction="#fecharJanela" styleClass="window-btn, window-btn-close" focusTraversable="false"/>
                    </HBox>
                </HBox>
            </HBox>

            <!-- Linha Principal de Conteúdo (Formulário + Confirmação) -->
            <HBox spacing="24" VBox.vgrow="ALWAYS">

                <!-- PAINEL CENTRAL (Formulário de Remoção) -->
                <VBox styleClass="form-card" spacing="18" HBox.hgrow="ALWAYS">

                    <!-- Banner de Aviso -->
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="warning-banner">
                        <Label text="⚠" styleClass="warning-text" style="-fx-font-size: 16px;"/>
                        <Label text="ATENÇÃO: A AÇÃO DE EXCLUSÃO DO CATÁLOGO É IRREVERSÍVEL" styleClass="warning-text"/>
                    </HBox>

                    <Label text="Identificação do Medicamento a Remover" styleClass="form-section-title"/>

                    <!-- Grid de Campos -->
                    <GridPane hgap="18" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="65"/>
                            <ColumnConstraints percentWidth="35"/>
                        </columnConstraints>

                        <!-- Linha 1: Medicamento e Quantidade -->
                        <Label text="MEDICAMENTO SELECIONADO *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label text="QUANTIDADE A REMOVER *" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <ComboBox
                            fx:id="campoMedicamento"
                            prefHeight="40.0"
                            maxWidth="Infinity"
                            promptText="Selecione o medicamento do catálogo"
                            styleClass="combo-box-field"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                        <ComboBox
                            fx:id="campoQuantidade"
                            prefHeight="40.0"
                            maxWidth="Infinity"
                            promptText="Qtd. a remover"
                            styleClass="combo-box-field"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>

                        <!-- Linha 2: Motivo da Remoção -->
                        <Label text="MOTIVO DA REMOÇÃO EXIGIDO *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2"/>

                        <TextField
                            fx:id="campoMotivo"
                            prefHeight="40.0"
                            promptText="Escreva detalhadamente o motivo do descarte (Ex: Lote vencido, recolhimento da Anvisa)"
                            styleClass="text-input-field"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="3"
                            GridPane.columnSpan="2"/>

                        <rowConstraints>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                        </rowConstraints>
                    </GridPane>

                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>

                <!-- PAINEL LATERAL DIREITO (Confirmação Segura) -->
                <VBox styleClass="summary-card" prefWidth="380.0" minWidth="360.0" spacing="16">
                    <Label text="Confirmação Segura" styleClass="summary-title"/>

                    <Separator styleClass="summary-divider"/>

                    <VBox spacing="6">
                        <Label text="POLÍTICA DE AUDITORIA" styleClass="summary-caption"/>
                        <Label text="Esta ação desativa de forma permanente a exibição comercial e movimentações deste medicamento no catálogo ativo do hospital."
                               wrapText="true"
                               styleClass="summary-item-name"/>
                    </VBox>

                    <Separator styleClass="summary-divider"/>

                    <Label text="Uma movimentação de SAÍDA será gerada no histórico automaticamente em nome do Coordenador para fins de conformidade hospitalar."
                           wrapText="true"
                           styleClass="summary-secondary-text"/>

                    <Separator styleClass="summary-divider"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <!-- Botão de Remoção -->
                    <Button
                        maxWidth="Infinity"
                        prefHeight="46.0"
                        text="🗑  Remover Permanentemente"
                        onAction="#remover"
                        styleClass="danger-action-btn"/>

                    <!-- Botão de Voltar -->
                    <Button
                        maxWidth="Infinity"
                        prefHeight="40.0"
                        text="Cancelar e Voltar"
                        onAction="#voltar"
                        styleClass="cancel-action-btn"/>
                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>
