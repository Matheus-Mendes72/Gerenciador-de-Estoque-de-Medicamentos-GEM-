<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane
    xmlns="http://javafx.com/javafx/27"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.gem.controller.CadastroMedicamentoController"
    maxHeight="900.0"
    maxWidth="1440.0"
    minHeight="900.0"
    minWidth="1440.0"
    prefHeight="900.0"
    prefWidth="1440.0">

    <stylesheets>
        <URL value="@Gem.css"/>
    </stylesheets>

    <!-- MENU LATERAL -->

    <left>

        <VBox
            minWidth="277.0"
            prefWidth="277.0"
            styleClass="sidebar">

            <VBox
                spacing="18"
                styleClass="sidebar-top">

                <HBox
                    alignment="CENTER_LEFT"
                    spacing="12">

                    <ImageView
                        fitHeight="68.0"
                        fitWidth="200.0"
                        preserveRatio="true">

                        <image>
                            <Image url="@images/gem-icon-home.png"/>
                        </image>

                    </ImageView>

                </HBox>

                <Separator
                    styleClass="sidebar-separator"/>

            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="5.0">

                <Button
                    maxWidth="1.7976931348623157E308"
                    prefHeight="45.0"
                    text="MOVIMENTAÇÃO"
                    onAction="#abrirMovimentacao"
                    styleClass="nav-button"/>

                <Button
                    maxWidth="1.7976931348623157E308"
                    prefHeight="45.0"
                    text="ESTOQUE"
                    onAction="#voltar"
                    styleClass="nav-button, nav-button-active"/>

                <Button
                    maxWidth="1.7976931348623157E308"
                    prefHeight="45.0"
                    text="HISTÓRICO"
                    styleClass="nav-button"/>

            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox
                spacing="16"
                styleClass="sidebar-bottom">

                <Separator
                    styleClass="sidebar-separator"/>

                <HBox
                    alignment="CENTER_LEFT"
                    spacing="12">

                    <Label
                        alignment="CENTER"
                        minWidth="43"
                        prefHeight="43"
                        prefWidth="43"
                        styleClass="avatar"
                        text="CC"/>

                    <Label
                        fx:id="usuarioLabel"
                        styleClass="sidebar-user"
                        text="Coordenador CAF"/>

                </HBox>

                <Button
                    text="Sair do sistema"
                    onAction="#sair"
                    styleClass="sidebar-exit"/>

            </VBox>

        </VBox>

    </left>

    <!-- ÁREA PRINCIPAL -->

    <center>

        <VBox
            spacing="25"
            styleClass="content-area">

            <!-- CABEÇALHO -->

            <HBox alignment="CENTER_LEFT">

                <VBox
                    prefWidth="700.0"
                    spacing="6">

                    <Label
                        text="Cadastrar Novo Medicamento"
                        styleClass="page-title"/>

                    <Label
                        text="Inclusão de novo item farmacêutico com registro completo de lote e especificações"
                        styleClass="page-subtitle"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label
                    fx:id="acessoLabel"
                    graphicTextGap="8"
                    styleClass="access-badge"
                    text="Acesso: Coordenador CAF">

                    <graphic>
                        <Circle
                            fill="#66BB6A"
                            radius="4"/>
                    </graphic>

                </Label>

            </HBox>

            <Separator/>

            <!-- CONTEÚDO -->

            <HBox
                alignment="TOP_LEFT"
                fillHeight="false"
                spacing="25">

                <!-- FORMULÁRIO -->

                <VBox
                    maxWidth="738"
                    prefWidth="738"
                    spacing="18"
                    styleClass="main-card">

                    <Label
                        text="DADOS DO MEDICAMENTO"
                        styleClass="card-title"/>

                    <GridPane
                        hgap="18"
                        vgap="18">

                        <columnConstraints>

                            <ColumnConstraints percentWidth="50"/>

                            <ColumnConstraints percentWidth="50"/>

                        </columnConstraints>

                        <!-- Linha 0: Princípio ativo | Dose -->

                        <VBox
                            spacing="6"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0">

                            <Label
                                text="PRINCÍPIO ATIVO"
                                styleClass="field-label"/>

                            <TextField
                                fx:id="campoPrincipioAtivo"
                                prefHeight="40"
                                promptText="Ex: Tramadol"
                                styleClass="field"/>

                        </VBox>

                        <VBox
                            spacing="6"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0">

                            <Label
                                text="DOSE"
                                styleClass="field-label"/>

                            <TextField
                                fx:id="campoDose"
                                prefHeight="40"
                                promptText="Ex: 50 mg/ml"
                                styleClass="field"/>

                        </VBox>

                        <!-- Linha 1: Classe terapêutica | Laboratório -->

                        <VBox
                            spacing="6"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1">

                            <Label
                                text="CLASSE TERAPÊUTICA"
                                styleClass="field-label"/>

                            <ComboBox
                                fx:id="campoTipoMed"
                                maxWidth="1.7976931348623157E308"
                                prefHeight="40"
                                promptText="Selecione a classe"
                                styleClass="field"/>

                        </VBox>

                        <VBox
                            spacing="6"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1">

                            <Label
                                text="LABORATÓRIO"
                                styleClass="field-label"/>

                            <TextField
                                fx:id="campoLaboratorio"
                                prefHeight="40"
                                promptText="Ex: EMS"
                                styleClass="field"/>

                        </VBox>

                        <!-- Linha 2: Quantidade inicial | Lote inicial -->

                        <VBox
                            spacing="6"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2">

                            <Label
                                text="QUANTIDADE INICIAL"
                                styleClass="field-label"/>

                            <TextField
                                fx:id="campoQuantidade"
                                prefHeight="40"
                                promptText="0"
                                styleClass="field"/>

                        </VBox>

                        <VBox
                            spacing="6"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2">

                            <Label
                                text="LOTE INICIAL"
                                styleClass="field-label"/>

                            <TextField
                                fx:id="campoLote"
                                prefHeight="40"
                                promptText="Ex: TRM24A01"
                                styleClass="field"/>

                        </VBox>

                        <!-- Linha 3: Responsável -->

                        <VBox
                            spacing="6"
                            GridPane.columnIndex="0"
                            GridPane.columnSpan="2"
                            GridPane.rowIndex="3">

                            <Label
                                text="RESPONSÁVEL PELO CADASTRO"
                                styleClass="field-label"/>

                            <TextField
                                fx:id="campoResponsavel"
                                editable="false"
                                focusTraversable="false"
                                prefHeight="40"
                                text="Usuário"
                                styleClass="field"/>

                        </VBox>

                    </GridPane>

                </VBox>

                <!-- REVISÃO DO REGISTRO -->

                <VBox
                    maxWidth="428"
                    prefWidth="428"
                    styleClass="summary">

                    <Label
                        text="REVISÃO DO REGISTRO"
                        styleClass="summary-title"/>

                    <Separator styleClass="summary-separator">

                        <VBox.margin>
                            <Insets
                                bottom="21"
                                top="22"/>
                        </VBox.margin>

                    </Separator>

                    <Label
                        text="CO-AUTOR DA AÇÃO"
                        styleClass="summary-label"/>

                    <Label
                        fx:id="resumoResponsavelLabel"
                        text="Usuário"
                        styleClass="summary-value">

                        <VBox.margin>
                            <Insets
                                bottom="14"
                                top="4"/>
                        </VBox.margin>

                    </Label>

                    <Label
                        text="PERFIL RESPONSÁVEL"
                        styleClass="summary-label"/>

                    <Label
                        fx:id="resumoPerfilLabel"
                        text="Coordenador do Setor"
                        styleClass="summary-value">

                        <VBox.margin>
                            <Insets top="4"/>
                        </VBox.margin>

                    </Label>

                    <Separator styleClass="summary-separator">

                        <VBox.margin>
                            <Insets
                                bottom="22"
                                top="21"/>
                        </VBox.margin>

                    </Separator>

                    <Button
                        maxWidth="1.7976931348623157E308"
                        prefHeight="50"
                        text="Salvar Medicamento"
                        styleClass="confirm-button"
                        onAction="#cadastrar"/>

                    <Button
                        maxWidth="1.7976931348623157E308"
                        prefHeight="50"
                        text="Cancelar"
                        styleClass="cancel-button"
                        onAction="#limparCampos">

                        <VBox.margin>
                            <Insets top="12"/>
                        </VBox.margin>

                    </Button>

                </VBox>

            </HBox>

        </VBox>

    </center>

</BorderPane>
