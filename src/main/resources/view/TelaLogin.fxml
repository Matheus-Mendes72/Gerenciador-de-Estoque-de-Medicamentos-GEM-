<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    xmlns="http://javafx.com/javafx/27"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.gem.view.LoginController"
    prefHeight="900.0"
    prefWidth="1440.0"
    style="-fx-background-color: #F5F7FA;">

    <GridPane
        AnchorPane.topAnchor="0.0"
        AnchorPane.bottomAnchor="0.0"
        AnchorPane.leftAnchor="0.0"
        AnchorPane.rightAnchor="0.0">

        <columnConstraints>

            <ColumnConstraints
                percentWidth="62.5"
                hgrow="ALWAYS"/>

            <ColumnConstraints
                percentWidth="37.5"
                hgrow="ALWAYS"/>

        </columnConstraints>

        <!-- IMAGEM DE FUNDO -->

        <ImageView
            fitWidth="900.0"
            fitHeight="900.0"
            preserveRatio="false"
            smooth="true"
            GridPane.columnIndex="0"
            GridPane.hgrow="ALWAYS"
            GridPane.vgrow="ALWAYS">

            <image>
                <Image url="@images/img-de-fundo-login.jpeg"/>
            </image>

        </ImageView>

        <!-- PAINEL DE LOGIN -->

        <VBox
            prefWidth="540.0"
            spacing="0.0"
            style="-fx-background-color: #F5F7FA;"
            GridPane.columnIndex="1"
            GridPane.hgrow="ALWAYS"
            GridPane.vgrow="ALWAYS">

            <padding>
                <Insets
                    left="50.0"
                    right="50.0"
                    top="200.0"/>
            </padding>

            <Label
                text="Acesse sua conta"
                style="-fx-font-family: 'Montserrat';
                       -fx-font-size: 30px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #0D47A1;">

                <VBox.margin>
                    <Insets bottom="2.0"/>
                </VBox.margin>

            </Label>

            <Label
                text="Selecione seu cargo e informe a senha para entrar"
                wrapText="true"
                style="-fx-font-family: 'Montserrat';
                       -fx-font-size: 17px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #1976D2;
                       -fx-line-spacing: 4px;">

                <VBox.margin>
                    <Insets bottom="105.0"/>
                </VBox.margin>

            </Label>

            <!-- CARGO -->

            <Label
                text="Cargo"
                style="-fx-font-family: 'Montserrat';
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #0D47A1;">

                <VBox.margin>
                    <Insets
                        left="17.0"
                        bottom="6.0"/>
                </VBox.margin>

            </Label>

            <ComboBox
                fx:id="cargoComboBox"
                prefHeight="42.0"
                maxWidth="440.0"
                promptText="Selecione seu cargo"
                style="-fx-background-color: white;
                       -fx-background-radius: 13px;
                       -fx-border-color: transparent;
                       -fx-font-family: 'Montserrat';
                       -fx-font-size: 14px;
                       -fx-text-fill: #777777;">

                <items>

                    <FXCollections fx:factory="observableArrayList">

                        <String fx:value="Coordenador"/>

                        <String fx:value="Farmacêutico"/>

                        <String fx:value="Técnico de Enfermagem"/>

                    </FXCollections>

                </items>

                <VBox.margin>
                    <Insets bottom="38.0"/>
                </VBox.margin>

            </ComboBox>

            <!-- SENHA -->

            <Label
                text="Senha"
                style="-fx-font-family: 'Montserrat';
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #0D47A1;">

                <VBox.margin>
                    <Insets
                        left="17.0"
                        bottom="6.0"/>
                </VBox.margin>

            </Label>

            <PasswordField
                fx:id="senhaField"
                prefHeight="42.0"
                maxWidth="440.0"
                promptText="Digite sua senha"
                style="-fx-background-color: white;
                       -fx-background-radius: 13px;
                       -fx-font-family: 'Montserrat';
                       -fx-font-size: 14px;">

                <VBox.margin>
                    <Insets bottom="60.0"/>
                </VBox.margin>

            </PasswordField>

            <!-- ENTRAR -->

            <Button
                fx:id="entrarButton"
                text="Entrar"
                prefHeight="44.0"
                prefWidth="440.0"
                maxWidth="440.0"
                mnemonicParsing="false"
                onAction="#login"
                style="-fx-background-color: #2E7D32;
                       -fx-background-radius: 13px;
                       -fx-font-family: 'Montserrat';
                       -fx-font-size: 19px;
                       -fx-font-weight: bold;
                       -fx-text-fill: white;
                       -fx-cursor: hand;"/>

        </VBox>

    </GridPane>

</AnchorPane>