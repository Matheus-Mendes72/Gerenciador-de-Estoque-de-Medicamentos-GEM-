<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/27"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.gem.view.TecnicoViewController"
    fx:id="root"
    prefWidth="1440"
    prefHeight="900"
    style="-fx-background-color: #F5F7FA;">

    <!-- MENU -->

    <left>

        <VBox
            prefWidth="277"
            style="-fx-background-color: #002D73;">

            <VBox
                spacing="18"
                style="-fx-padding: 25 17 0 17;">

                <ImageView
                    fitHeight="68"
                    fitWidth="200"
                    preserveRatio="true">

                    <image>
                        <Image url="@images/gem-icon-home.png"/>
                    </image>

                </ImageView>

                <Separator
                    style="-fx-background-color: rgba(255,255,255,0.25);"/>

            </VBox>

            <Region
                VBox.vgrow="ALWAYS"/>

            <VBox
                spacing="5">

                <Button
                    maxWidth="1.7976931348623157E308"
                    prefHeight="45"
                    text="MOVIMENTAÇÃO"
                    onAction="#abrirMovimentacao"
                    style="-fx-background-color: #66BB6A;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 0 20 0 20;
                           -fx-cursor: hand;"/>

                <Button
                    maxWidth="1.7976931348623157E308"
                    prefHeight="45"
                    text="ESTOQUE"
                    style="-fx-background-color: #002D73;
                           -fx-text-fill: #B7C5DB;
                           -fx-font-weight: bold;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 0 20 0 20;"/>

                <Button
                    maxWidth="1.7976931348623157E308"
                    prefHeight="45"
                    text="HISTÓRICO"
                    style="-fx-background-color: #002D73;
                           -fx-text-fill: #B7C5DB;
                           -fx-font-weight: bold;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 0 20 0 20;"/>

            </VBox>

            <Region
                VBox.vgrow="ALWAYS"/>

            <VBox
                spacing="15"
                style="-fx-padding: 20 17 24 17;">

                <Separator
                    style="-fx-background-color: rgba(255,255,255,0.25);"/>

                <Label
                    text="TÉCNICO DE ENFERMAGEM"
                    style="-fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;"/>

                <Button
                    text="Sair do sistema"
                    onAction="#sair"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"/>

            </VBox>

        </VBox>

    </left>

    <!-- CONTEÚDO -->

    <center>

        <VBox
            spacing="20"
            style="-fx-padding: 50;">

            <Label
                text="Área do Técnico de Enfermagem"
                style="-fx-text-fill: #0D3B82;
                       -fx-font-size: 28px;
                       -fx-font-weight: bold;"/>

            <Label
                text="Acesso às movimentações permitidas para o profissional."
                style="-fx-text-fill: #53627A;
                       -fx-font-size: 15px;"/>

            <VBox
                spacing="12"
                style="-fx-background-color: white;
                       -fx-background-radius: 14;
                       -fx-padding: 30;
                       -fx-border-color: #D9E1EC;
                       -fx-border-radius: 14;">

                <Label
                    text="Permissões"
                    style="-fx-text-fill: #0D3B82;
                           -fx-font-size: 18px;
                           -fx-font-weight: bold;"/>

                <Label
                    text="• Registrar saída de medicamentos"/>

                <Label
                    text="• Registrar retorno de medicamentos"/>

                <Label
                    text="• Consultar as telas permitidas pelo sistema"/>

                <Button
                    text="Abrir movimentação"
                    onAction="#abrirMovimentacao"
                    style="-fx-background-color: #1976D2;
                           -fx-background-radius: 8;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 12 25;
                           -fx-cursor: hand;"/>

            </VBox>

        </VBox>

    </center>

</BorderPane>